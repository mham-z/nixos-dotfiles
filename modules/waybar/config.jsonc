[
	{
		"position": "top",
		"layer": "top",
		"height": 24,
		
		"modules-left": ["custom/cava-left"],
		"modules-center": ["sway/workspaces", "sway/mode"],
		"modules-right": ["custom/cava-right"],

		"custom/cava-right": {
			"format": "{}",
			"exec": "~/dotfiles/scripts/cava-waybar -r"
		},

		"custom/cava-left": {
			"format": "{}",
			"exec": "~/dotfiles/scripts/cava-waybar -l"
		}
	},
	{
		"position": "bottom",
		"layer": "top",
		"height": 24,
		"fixed-center": false,

		"modules-left": ["tray", "custom/s-gray", "power-profiles-daemon", "custom/notifs", "idle_inhibitor"],
		"modules-center": [
			"cpu",
			"custom/cpu-temp",
			"custom/s-gold",
			"custom/dgpu-load",
			"custom/dgpu-temp",
			"custom/s-gold",
			"memory",
			"custom/s-gold",
			"disk",
			"custom/s-gold",
			"custom/fan1",
			"custom/fan2"
		],
		"modules-right": [
			"wireplumber#sink",
			"custom/s-rose",
			"wireplumber#source",
			"custom/s-rose",
			"backlight",
			"custom/s-gray",
			"bluetooth",
			"custom/s-yellow",
			"network#wlan",
			"custom/s-yellow",
			"network#ethernet",
			"custom/s-yellow",
			"battery",
			"custom/s-gray",
			"clock"
		],

		// Separators
		"custom/s-gray": {
			"format": "∼",
			"interval": "once",
			"tooltip": false
		},
		"custom/s-foam": {
			"format": "│",
			"interval": "once",
			"tooltip": false
		},
		"custom/s-rose": {
			"format": "│",
			"interval": "once",
			"tooltip": false
		},
		"custom/s-gold": {
			"format": "│",
			"interval": "once",
			"tooltip": false
		},
		"custom/s-yellow": {
			"format": "│",
			"interval": "once",
			"tooltip": false
		},

		// Center
		"cpu": {
			"interval": 2,
			"format": " {usage}% "
		},

		"custom/cpu-temp": {
			"interval": 5,
			"exec": "awk '{printf \"%.0f\", $1/1000}' /sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input",
			"format": "{}°"
		},

		"custom/dgpu-load": {
			"interval": 2,
			"exec": "bash -c 'GPU=0000:01:00.0; [ \"$(< /sys/bus/pci/devices/$GPU/power/runtime_status)\" != active ] && { echo N/A; exit; }; nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null || echo N/A'",
			"format": "󰆦 {}% "
		},

		"custom/dgpu-temp": {
			"interval": 5,
			"exec": "bash -c 'GPU=0000:01:00.0; [ \"$(< /sys/bus/pci/devices/$GPU/power/runtime_status)\" != active ] && { echo N/A; exit; }; nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null || echo N/A'",
			"format": "{}°"
		},

		"memory": {
			"interval": 2,
			"format": " {used:0.1f}G/{total:0.1f}G"
		},

		"disk": {
			"interval": 10,
			"path": "/",
			"format": "󱛟 {percentage_used}%"
		},

		"custom/fan1": {
			"interval": 2,
			"exec": "bash -c 'v=\"$(cat /sys/devices/platform/thinkpad_hwmon/hwmon/hwmon*/fan1_input 2>/dev/null)\"; [ \"$v\" = \"65535\" ] && v=DEAD; echo ${v:-N/A}'",
			"format": "󱑲 {} ⁃ "
		},

		"custom/fan2": {
			"interval": 2,
			"exec": "bash -c 'v=\"$(cat /sys/devices/platform/thinkpad_hwmon/hwmon/hwmon*/fan2_input 2>/dev/null)\"; [ \"$v\" = \"65535\" ] && v=DEAD; echo ${v:-N/A}'",
			"format": "󱑳 {}"
		},


		// Left
		"tray": {
			"icon-size": 16,
			"spacing": 2,
			"show-passive-items": true
		},
		"power-profiles-daemon": {
			"format": "{icon}",
			"format-icons": {
				"default": "󱐋",
				"performance": "󱐋",
				"balanced": "󰗑",
				"power-saver": "󰌪"
			}
		},
		"custom/notifs": {
			"exec": "makoctl mode | grep -qi dnd && echo 󰂛 || echo 󰂚",
			"interval": 1,
			"on-click": "makoctl mode -t dnd",
			"on-click-right": "makoctl dismiss -a",
			"format": "{}",
			"tooltip": false
		},
		"idle_inhibitor": {
			"format": "{icon}",
			"format-icons": {
				"activated": "󰅶",
				"deactivated": "󰾪"
			},
			"tooltip": false
		},

		// Right
		"wireplumber#sink": {
			"format": "  {volume}%",
			"format-muted": " ",
			"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
			"scroll-step": 5
		},
		"wireplumber#source": {
			"node-type": "Audio/Source",
			"format": " {volume}%",
			"format-muted": " MUTE",
			"on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
			"scroll-step": 5
		},
		"backlight": {
			"format": "󰃞 {percent}%",
			"min-brightness": 1
		},
		"bluetooth": {
			"format": "󰂯 {status}",
			"format-connected": "󰂱",
			"format-connected-battery": "󰂱 {device_battery_percentage}%",
			"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
			"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
			"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
			"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
		},
		"network#ethernet": {
			"interval": 10,
			"interface": "e*",
			"format-ethernet": "󰈁 {ipaddr}",
			"format-disconnected": "󰈂" 
		},
		"network#wlan": {
			"interval": 10,
			"interface": "wl*",
			"format-wifi": "󰤨  {ipaddr} {signalStrength}% {essid}",
			"format-disconnected": "󰤭 ",
			"max-length": 30
		},
		"battery": {
			"format": "󰁹 {capacity}%{time}",
			"format-time": " {H}:{m} left",
			"format-icons": {
				"default": [""],
				"charging": ["Charging"]
			},
			"events": {
				"on-discharging-warning": "notify-send -u critical -t 10000 -h string:x-canonical-private-synchronous:battery-alert \"Warning\" \"Low battery, please plug in the device.\"",
				"on-discharging-critical": "notify-send -u critical -t 10000 -h string:x-canonical-private-synchronous:battery-alert \"Critical\" \"Very low battery. Charge immediately, or the device will shut down!\" && pw-play /usr/share/sounds/freedesktop/stereo/dialog-warning.oga"
			},
			"states": {
				"warning": 30,
				"critical": 15
			}
		},
		"clock": {
			"interval": 1,
			"format": "{:%w-%Y-%m-%d %I:%M:%S %p}"
		}
	}
]